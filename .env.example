# Local credentials and settings for the modael bridge.
# Copy this file to .env (gitignored). The bootstrap task fills credentials
# automatically; deploy parameters you edit by hand.

# --- credentials (do not share) ---
# BRIDGE_TOKEN and LITELLM_MASTER_KEY are auto-generated by the bootstrap task.
# HF_TOKEN is optional but strongly recommended for the model-download task —
# anonymous HuggingFace pulls are heavily rate-limited. Get one at
# https://huggingface.co/settings/tokens (read scope is enough), paste below,
# then re-run the 'modael: 1. setup' task to sync it into the Modal secret.
BRIDGE_TOKEN=
LITELLM_MASTER_KEY=
HF_TOKEN=

# --- Modal endpoint (paste after the first `modael: deploy`) ---
# Format: https://<workspace>--claude-code-bridge-serve.modal.run/v1
# The trailing /v1 is required.
MODAL_BRIDGE_URL=

# --- mobile-app-farm (optional; only if you use the APK/IPA farm scripts) ---
# Real values belong in the gitignored engagement .env (e.g. .env.deepinfra), never here.
# MobSF sibling container for static scans (leave blank to skip MobSF):
MOBSF_URL=
MOBSF_KEY=
# Authenticated Google Play acquisition (blank = APKPure/F-Droid, no creds). Mint the
# AAS token once per the mobile-app-farm/reference/acquisition.md instructions:
GOOGLE_PLAY_EMAIL=
GOOGLE_PLAY_AAS_TOKEN=
# iOS IPA acquisition via ipatool (App Store binaries are FairPlay-encrypted — static only):
APPLE_ID=
APPLE_PASSWORD=
